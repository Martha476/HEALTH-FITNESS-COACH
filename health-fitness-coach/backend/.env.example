"""
Environment configuration template
Copy this to .env and fill in your values
"""

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# OpenAI Configuration
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4

# Anthropic Configuration (Optional)
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-opus-4-1-20250805

# Google Configuration (Optional)
GOOGLE_API_KEY=your-google-key-here
GOOGLE_MODEL=gemini-1.5-pro

# Default LLM (openai, anthropic, or google)
DEFAULT_LLM=openai

# Database
DATABASE_URL=sqlite:///fitness_coach.db

# Redis (for caching)
REDIS_URL=redis://localhost:6379/0
ENABLE_CACHE=True

# Vector Database (Pinecone for RAG)
ENABLE_RAG=True
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_INDEX=fitness-coach
PINECONE_ENVIRONMENT=us-east1-aws

# LangSmith Observability
ENABLE_LANGSMITH=False
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=health-fitness-coach

# Features
ENABLE_AUTH=False
ENABLE_FEEDBACK=True
ENABLE_RETRY=True

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=1

# Token & Cost Tracking
ENABLE_TOKEN_TRACKING=True

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
