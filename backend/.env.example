"""
Environment configuration template
Copy this to .env and fill in your values
"""

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# OpenAI Configuration
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4

# Anthropic Configuration (Optional)
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-opus-4-1-20250805

# Google Configuration (Optional)
GOOGLE_API_KEY=your-google-key-here
GOOGLE_MODEL=gemini-1.5-pro

# YouTube Configuration (for exercise video search)
YOUTUBE_API_KEY=your-youtube-api-key-here

# Default LLM (openai, anthropic, or google)
DEFAULT_LLM=openai

# Database
DATABASE_URL=sqlite:///fitness_coach.db

# Redis (for caching)
REDIS_URL=redis://localhost:6379/0
ENABLE_CACHE=True

# Vector Database (Pinecone for RAG)
ENABLE_RAG=True
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_INDEX=fitness-coach
PINECONE_ENVIRONMENT=us-east1-aws

# LangSmith Observability
ENABLE_LANGSMITH=False
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=health-fitness-coach

# Features
ENABLE_AUTH=False
ENABLE_FEEDBACK=True
ENABLE_RETRY=True

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=1

# Token & Cost Tracking
ENABLE_TOKEN_TRACKING=True

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Frontend URL (OAuth redirects, email links)
FRONTEND_URL=http://localhost:3000

# Google OAuth (Continue with Google)
# Create credentials: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Supabase (user storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
JWT_SECRET_KEY=change-this-in-production
